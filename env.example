# Copy this file to .env and fill in what you need. Every value is optional.

# Where the SQLite database file lives
ECOPULSE_DB=ecopulse.db

# Turns on the AI step of the recommendation engine. Without it, EcoPulse uses
# rule-based wording. Get a key from Google AI Studio.
GEMINI_API_KEY=

# Which Gemini model to call
GEMINI_MODEL=gemini-2.5-flash

# Region used when none is given (a country code such as IN, GB or US)
ECOPULSE_DEFAULT_REGION=IN
